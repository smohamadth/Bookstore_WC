{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		},
		"color": {
			"palette": [
				{ "slug": "ink", "name": "Ink", "color": "#20242c" },
				{ "slug": "paper", "name": "Paper", "color": "#f6f1e6" },
				{ "slug": "card", "name": "Card", "color": "#fffdf8" },
				{ "slug": "accent", "name": "Emerald", "color": "#2e6b52" },
				{ "slug": "accent-dark", "name": "Dark emerald", "color": "#21503d" },
				{ "slug": "gold", "name": "Gold", "color": "#c9972e" }
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "'Newsreader', Georgia, 'Times New Roman', serif",
					"slug": "display",
					"name": "Display (Newsreader)"
				},
				{
					"fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
					"slug": "body",
					"name": "Body (Inter)"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "#f6f1e6",
			"text": "#20242c"
		}
	}
}
