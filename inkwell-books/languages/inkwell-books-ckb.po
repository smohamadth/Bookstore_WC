msgstr "بەخێربێیت بۆ لیستی خوێندنەوە!"

#: includes/newsletter.php:112
msgid "Thank you!"
msgstr "سوپاس!"

#: includes/newsletter.php:115, includes/newsletter.php:191
msgid "Too many attempts. Please try again later."
msgstr "هەوڵی زۆر دراوە. تکایە دواتر دووبارە هەوڵ بدە."

#: includes/newsletter.php:189
msgid "Thank you — you are on the list!"
msgstr "سوپاس — لە لیستەکەدایت!"

#: includes/newsletter.php:190
msgid "Please check your email and consent, then try again."
msgstr "تکایە ئیمەیڵ و ڕەزامەندییەکەت بپشکنە و دووبارە هەوڵ بدە."

#: includes/newsletter.php:192
msgid ""
"If that address was subscribed, it has been removed from the reading list."
msgstr "ئەگەر ئەو ناونیشانە ئەندام بووبێت، لە لیستی خوێندنەوە سڕاوەتەوە."

#: includes/newsletter.php:216
msgid "Leave this field empty"
msgstr "ئەم خانەیە بەتاڵ بهێڵەوە"

